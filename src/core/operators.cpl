macro _def_operator op builtin_call T1 T2 T {
    operator op a: T1 b: T2 {
        ret builtin_call[T](T a T b)
    }
}

macro _def_cmp_operator op builtin_call T1 T2 T {
    operator op a: T1 b: T2 {
        ret builtin_call[T](T a T b)
    }
}

macro _def_full_operator op builtin_call {
    _def_operator op; builtin_call; i32; i32; i32;
    _def_operator op; builtin_call; i64; i32; i64;
    _def_operator op; builtin_call; f32; i32; f32;
    _def_operator op; builtin_call; f64; i32; f64;

    _def_operator op; builtin_call; i32; i64; i64;
    _def_operator op; builtin_call; i64; i64; i64;
    _def_operator op; builtin_call; f32; i64; f32;
    _def_operator op; builtin_call; f64; i64; f64;

    _def_operator op; builtin_call; i32; f32; f32;
    _def_operator op; builtin_call; i64; f32; f32;
    _def_operator op; builtin_call; f32; f32; f32;
    _def_operator op; builtin_call; f64; f32; f64;

    _def_operator op; builtin_call; i32; f64; f64;
    _def_operator op; builtin_call; i64; f64; f64;
    _def_operator op; builtin_call; f32; f64; f64;
    _def_operator op; builtin_call; f64; f64; f64;
}

macro _def_operator_with_char op builtin_call {
    _def_operator op; builtin_call; char; i32; char;
    _def_operator op; builtin_call; char; i64; char;
    _def_operator op; builtin_call; i32; char; char;
    _def_operator op; builtin_call; i64; char; char;
}

_def_full_operator +; _builtin_add;
_def_operator_with_char +; _builtin_add;
_def_full_operator -; _builtin_sub;
_def_operator_with_char -; _builtin_sub;
_def_full_operator *; _builtin_mul;
_def_full_operator /; _builtin_div;

operator- a: i32
    ret 0 - a

operator- a: i64
    ret 0L - a

operator- a: f32
    ret 0.0 - a

operator- a: f64
    ret 0.0 - a


macro _def_full_cmp_operator op builtin_call {
    _def_cmp_operator op; builtin_call; char; char; char;
    _def_cmp_operator op; builtin_call; i32; char; i32;
    _def_cmp_operator op; builtin_call; i64; char; i64;
    _def_cmp_operator op; builtin_call; f32; char; f32;
    _def_cmp_operator op; builtin_call; f64; char; f64;

    _def_cmp_operator op; builtin_call; char; i32; i32;
    _def_cmp_operator op; builtin_call; i32; i32; i32;
    _def_cmp_operator op; builtin_call; i64; i32; i64;
    _def_cmp_operator op; builtin_call; f32; i32; f32;
    _def_cmp_operator op; builtin_call; f64; i32; f64;

    _def_cmp_operator op; builtin_call; char; i64; i64;
    _def_cmp_operator op; builtin_call; i32; i64; i64;
    _def_cmp_operator op; builtin_call; i64; i64; i64;
    _def_cmp_operator op; builtin_call; f32; i64; f32;
    _def_cmp_operator op; builtin_call; f64; i64; f64;

    _def_cmp_operator op; builtin_call; char; f32; f32;
    _def_cmp_operator op; builtin_call; i32; f32; f32;
    _def_cmp_operator op; builtin_call; i64; f32; f32;
    _def_cmp_operator op; builtin_call; f32; f32; f32;
    _def_cmp_operator op; builtin_call; f64; f32; f64;

    _def_cmp_operator op; builtin_call; char; f64; f64;
    _def_cmp_operator op; builtin_call; i32; f64; f64;
    _def_cmp_operator op; builtin_call; i64; f64; f64;
    _def_cmp_operator op; builtin_call; f32; f64; f64;
    _def_cmp_operator op; builtin_call; f64; f64; f64;
}

operator% a: i32 b: i32
    ret _builtin_mod[i32](a b)

operator% a: i64 b: i64
    ret _builtin_mod[i64](a b)

operator% a: i64 b: i32
    ret _builtin_mod[i64](a i64 b)

operator% a: i32 b: i64
    ret _builtin_mod[i64](i64 a b)

_def_full_cmp_operator ==; _builtin_eq;
_def_full_cmp_operator <; _builtin_lesser;

operator!= a b
    ret !(a == b)

operator<= a b
    ret a < b || a == b

operator> a b
    ret b < a

operator>= a b
    ret a > b || a == b

operator&& a: bool b: bool
    ret _builtin_and[bool](a b)

operator|| a: bool b: bool
    ret _builtin_or[bool](a b)

operator! a: bool
    ret _builtin_not(a)

operator+=[T] a: &T b
    |a = |a + b

operator-=[T] a: &T b
    |a = |a - b

operator*=[T] a: &T b
    |a = |a * b

operator/=[T] a: &T b
    |a = |a / b

operator%=[T] a: &T b
    |a = |a % b

operator++[T] a: &T
    |a += 1

operator--[T] a: &T
    |a -= 1
