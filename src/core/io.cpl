fn read_i64
    c = _builtin_getchar()
    while c == ' ' || c == '\n'
        c = _builtin_getchar()
    neg = false
    if c == '-'
        neg = true
        c = _builtin_getchar()
    res = 0L
    while c >= '0' && c <= '9'
        res *= 10L
        res += i64 c - i64 '0'
        c = _builtin_getchar()
    if neg
        res = -res
    ret res

fn read_i32
    ret i32 read_i64()


fn read_str
    c = _builtin_getchar()
    while c == ' ' || c == '\n'
        c = _builtin_getchar()
    res = Str()
    while c != ' ' && c != '\n'
        res.push(c)
        c = _builtin_getchar()
    ret res
