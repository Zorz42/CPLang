fn read_i64
    c = _builtin_getchar()
    while c == ' ' || c == '\n'
        c = _builtin_getchar()
    neg = false
    if c == '-'
        neg = true
        c = _builtin_getchar()
    res = 0L
    while c >= '0' && c <= '9'
        res *= 10L
        res += i64 c - i64 '0'
        c = _builtin_getchar()
    if neg
        res = -res
    ret res

fn read_i32
    ret i32 read_i64()

fn read_str
    c = _builtin_getchar()
    while c == ' ' || c == '\n'
        c = _builtin_getchar()
    res = Str()
    while c != ' ' && c != '\n'
        res.push(c)
        c = _builtin_getchar()
    ret res

fn print x: char
    _builtin_putchar(x)

fn print x: Vec[char]
    for c x
        print(c)

fn print x: i32
    print(i64 x)

fn print x: i64
    if x == 0
        print('0')
        ret

    if x < 0
        print('-')
        x = -x

    s = Str()
    while x != 0
        s.push(x % 10 + '0')
        x /= 10

    for i 0..s.size()
        print(s[s.size() - 1 - i])

fn print x: f32
    print(f64 x)

fn print x: f64
    if x < 0
        print('-')
        x = -x

    x *= 1000000000
    x2 = i64 x
    s = Str()
    while x2 >= 1 || s.size() < 11
        s.push(x2 % 10 + '0')
        if s.size() == 9
            s.push('.')
        x2 /= 10

    for i 0..s.size()
        print(s[s.size() - 1 - i])

fn print x: bool
    print('0' + i32 x)

fn print x: void
    print("()")
