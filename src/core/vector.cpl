struct _Vec[T]
    size: i32
    capacity: i32
    vec: &T

    fn operator[] i: i32
        ret &_builtin_index(self.vec i)

    fn expand wanted_size
        while wanted_size > self.capacity
            self.capacity = self.capacity * 2
            old_vec = self.vec
            self.vec = _builtin_alloc(self.capacity)
            for i 0..self.size
                self[i] = _builtin_index(old_vec i)

    fn push x: T
        self.expand(self.size + 1)
        self[self.size] = x
        self.size++

    fn pop
        self.size--

    fn iter
        ret _VecIter vec self i 0

// constructors
fn Vec
    ret _Vec size 0 vec _builtin_alloc(1) capacity 1

fn Vec[T] size: i32 default: T
    vec = Vec()
    for i 0..size
        vec.push(default)
    ret vec

struct _VecIter
    vec: &_Vec
    i: i32

    fn has_next
        ret self.i < self.vec.size

    fn next
        self.i++
        ret self.vec[self.i - 1]


