struct _Vec[T]
    _size: i32
    _capacity: i32
    _vec: &T

    fn operator[] i: i32
        ret &_builtin_index(self._vec i)

    fn operator[] i: i64
        ret self[i32 i]

    fn expand wanted_size
        while wanted_size > self._capacity
            self._capacity = self._capacity * 2
            old_vec = self._vec
            self._vec = _builtin_alloc(self._capacity)
            for i 0..self._size
                self[i] = _builtin_index(old_vec i)

    fn push x: T
        self.expand(self._size + 1)
        self[self._size] = x
        self._size++

    fn pop
        self._size--

    fn iter
        ret _VecIter vec self i 0

    fn size
        ret self._size

// constructors
fn Vec[T]
    ret _Vec[T] _size 0 _vec _builtin_alloc(1) _capacity 1

fn Vec[T] size: i32 default: T
    vec = Vec()
    for i 0..size
        vec.push(default)
    ret vec

struct _VecIter
    vec: &_Vec
    i: i32

    fn has_next
        ret self.i < self.vec.size

    fn next
        self.i++
        ret self.vec[self.i - 1]


