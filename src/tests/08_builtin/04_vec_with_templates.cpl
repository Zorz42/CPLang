//OUT="10"

struct Vec2[T]
    size: i32
    vec: &T

    fn index i: i32
        _builtin_alloc[T](10)
        ret &_builtin_index(self.vec i)

fn new_vec size
    ret Vec2 size size vec _builtin_alloc(size)

fn new_vec
    ret new_vec(0)

fn main
    vec = new_vec(10)
    |vec.index(0) = 10
    out "{|vec.index(0)}"