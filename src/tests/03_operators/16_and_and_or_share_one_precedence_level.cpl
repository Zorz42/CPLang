//OUT="1 0 1 0"

// && and || currently sit on the same precedence level and are folded left to
// right, which differs from C — see 13_known_bugs/00 and 13_known_bugs/01.
// The combinations here give the same answer under either reading, so this
// case stays valid once that is fixed. Write the parentheses out whenever the
// grouping could matter.

fn main
    out "{(true || false) && true} {(true || false) && false} {true || (false && false)} {false && (true || true)}"
