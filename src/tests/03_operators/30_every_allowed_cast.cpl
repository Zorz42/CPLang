//OUT="1 1 1.000000000 1.000000000 1 A|2 2 2.000000000 2.000000000 2 B|3 3 3.000000000 3.000000000|1 1|67 67 C"

// The cast table in builtin_functions.rs allows i32/i64 to any primitive,
// f32/f64 to the numeric ones, bool to bool/i32/i64, and char to char/i32/i64.
// This walks all of it. Note `bool 2L` prints 2, not 1 — see
// 13_known_bugs/24_casting_to_bool_does_not_normalize.cpl.

fn main
    i = 1
    l = 2L
    f = f32 3.0
    b = true
    c = 'C'
    out "{i32 i} {i64 i} {f32 i} {f64 i} {bool i} {char (i + 64)}|"
    out "{i32 l} {i64 l} {f32 l} {f64 l} {bool l} {char (l + 64L)}|"
    out "{i32 f} {i64 f} {f32 f} {f64 f}|"
    out "{i32 b} {i64 b}|"
    out "{i32 c} {i64 c} {char c}"
