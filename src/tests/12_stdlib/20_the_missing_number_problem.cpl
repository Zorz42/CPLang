//IN="5\n2 3 1 5\n"
//OUT="4\n"

// The same program as main.cpl: read n-1 of the numbers 1..n and print the one
// that is missing.

fn main
    n = read_i32()
    vec = Vec(n 0)
    for i 0..n-1
        a = read_i32()
        vec[a - 1] = 1
    for i 0..n
        if vec[i] == 0
            out "{i+1}\n"
