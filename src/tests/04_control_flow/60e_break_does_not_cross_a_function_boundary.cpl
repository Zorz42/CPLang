//ERR 9 4 9 7
//MSG="Maximum possible depth for this break statement is 0."

// `helper` is called from inside a loop, but the loop is in the caller. A
// `brk` binds to a loop lexically enclosing it in the same body, and there is
// none here, so `helper` is rejected on its own — whether or not anyone calls
// it from a loop.

fn helper
    brk

fn main
    for i 0..3
        helper()
