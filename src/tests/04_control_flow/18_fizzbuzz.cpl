//OUT="1 2 F 4 B F 7 8 F B 11 F 13 14 FB "

fn main
    for i 1..16
        if i % 15 == 0
            out "FB "
        else
            if i % 3 == 0
                out "F "
            else
                if i % 5 == 0
                    out "B "
                else
                    out "{i} "
