//ERR 10 8 10 13
//MSG="Maximum possible depth for this break statement is 1."

// Only one loop encloses the `brk 2`, so there is no second one to leave. The
// level is checked against the actual nesting depth rather than clamped to it —
// silently behaving like `brk 1` would hide the typo. The span covers the whole
// statement, level included, since it is the pair that is wrong.

fn main
    for i 0..3
        brk 2
