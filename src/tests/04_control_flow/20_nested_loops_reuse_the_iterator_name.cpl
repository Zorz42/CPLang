//OUT="0 1 1 2 |0 1 1 2 |"

// The inner loop declares an `i` while the outer loop's `i` is still live, so
// the inner scope has to remember the outer binding and put it back on the way
// out. This is the only shape in the suite that shadows a name.

fn main
    for i 0..2
        for i 0..2
            out "{i} "
        for i 1..3
            out "{i} "
        out "|"
