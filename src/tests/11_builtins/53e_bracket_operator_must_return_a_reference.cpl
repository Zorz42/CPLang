//ERR 16 10 16 16
//MSG="No candidate found for this function call"

// `x[i]` lowers to `*x.operator[](i)`, so an operator[] that returns a plain
// value cannot be used at all, not even to read. The element type is pinned
// to i32 here: with a template element type the dereference would instead
// infer T = &i32, and the program would compile.

struct Vec2
    vec: &i32

    fn operator[] i: i32
        ret _builtin_index(self.vec i)

fn main
    vec = Vec2 vec _builtin_alloc(10)
    out "{vec[0]}"
