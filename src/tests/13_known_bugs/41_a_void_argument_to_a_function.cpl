//BUG="a void parameter emits `void var0` in the C signature, which gcc rejects"
//OUT="7"

// A void value passed to a function deduces a void parameter, and codegen puts
// it in the signature — `static int func2(void var0,int var1)`, which gcc
// rejects with "'void' must be the first and only parameter if specified".
//
// The parameter should be left out of the emitted signature and out of the call,
// with the remaining arguments keeping their positions.

fn nothing
    ret

fn take x y
    ret y

fn main
    out "{take(nothing() 7)}"
