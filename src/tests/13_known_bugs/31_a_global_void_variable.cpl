//BUG="a global of type void emits `static void var0;`, which gcc rejects"
//OUT="ok"

// Globals are emitted by a different path from locals — see
// 02_variables/20_a_global_of_a_struct_type.cpl, where that path had a bug of
// its own — so a void global needs its own case. It should be dropped exactly
// like a void local.

g: void

fn main
    out "ok"
