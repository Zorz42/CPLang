//BUG="a void field does not build, so its initializer cannot be shown to run"
//OUT="1 5"

// The field-level counterpart of 28_a_bound_void_call_still_runs.cpl: dropping
// the member from the struct must not drop the expression that was written for
// it. `bump()` still has to be called when the struct is built.
//
// This is the awkward one, because the value has nowhere to go — the emitted
// initializer has no slot to put it in, so the call has to be sequenced beside
// the instantiation rather than inside it.

g = 0

fn bump
    g++
    ret

struct T
    x
    y

fn main
    a = T x bump() y 5
    out "{g} {a.y}"
