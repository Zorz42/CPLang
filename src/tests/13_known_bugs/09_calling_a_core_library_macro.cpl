//BUG="FEEDBACK.md 1.7 — merging positions across files aborts the process"
//OUT="b"

// Macro expansion splices call-site tokens (this file, file 0) into the macro
// body's tokens (src/core/operators.cpl, a different file id) — gen_block in
// src/compiler/macros.rs — and the parser then merges positions freely. The
// merge asserts both sides come from the same file
// (`assert_eq!(self.file_ident, rhs.file_ident)`, src/compiler/error.rs), so
// using any core macro aborts the process:
//
//     thread '<unnamed>' panicked at src/compiler/error.rs:38:9:
//     assertion `left == right` failed: left: 1, right: 0
//
// Fix: make Add fall back to the left-hand side (or to unknown()) when the
// file ids differ. A span should be able to say "this spans two files", or
// decline to, without killing the compile.
//
// The program below adds a char+char overload, which the core library does not
// define, and prints 'a' + 1 as a char.

_def_operator +; _builtin_add; char; char; char;

fn main
    a = 'a'
    one = char 1
    out "{a + one}"
