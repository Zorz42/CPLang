//BUG="FEEDBACK.md 1.9 — parse::<f32> accepts inf, nan and exponent forms"
//OUT="1"

// string_to_token falls through to parse::<f32>(), which accepts "inf",
// "infinity" and "NaN" in any case, so a variable named `inf` is silently a
// float constant and this program fails with
// "This expression cannot be f64 and i32 at the same time."
//
// It gets worse if such a value reaches codegen: IRConstant::Float is emitted
// with format!("{x}"), so the bare token `inf` or `NaN` lands in the C file
// and gcc rejects it.
//
// Fix: validate the shape of a numeric literal — digits, at most one '.' —
// before handing it to parse.

fn main
    inf = 1
    out "{inf}"
