//BUG="Vec's i64 operator[] returns a value, so indexing a Vec with an i64 fails"
//OUT="20"

// Not in FEEDBACK.md. The lowerer now turns `x[i]` into
// `*x.operator[](i)`, so every operator[] has to return a reference. Vec's i64
// overload in src/core/vector.cpl forwards to the i32 one:
//
//     fn operator[] i: i64
//         ret self[i32 i]
//
// `self[i32 i]` is now the dereferenced element, a plain T, so this overload
// returns T rather than &T. Dereferencing that is impossible, and `v[i]` with
// an i64 `i` fails with "No candidate found for this function call".
//
// Fix: `ret &self[i32 i]`. A struct written the same way with the `&` indexes
// fine with an i64.

fn main
    v = Vec()
    v.push(10)
    v.push(20)
    i = 1L
    out "{v[i]}"
