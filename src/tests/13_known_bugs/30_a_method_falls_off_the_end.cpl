//BUG="a method may fall off the end the same way a free function may"
//ERR any

// Methods are declared inside a struct and carry a `self`, so they reach the
// normalizer by their own path — see 08_structs/12_method_declaration.cpl. The
// check has to cover them too, not just top-level functions.

struct Box
    v: i32

    fn get n
        if n > 0
            ret self.v

fn main
    b = Box v 7
    out "{b.get(-1)}"
