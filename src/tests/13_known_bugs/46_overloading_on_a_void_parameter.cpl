//BUG="an overload taking a void parameter emits `void var0` in its C signature"
//OUT="1 2"

// Void is erased in codegen, not in the type system: the two overloads stay
// distinct and `f(nothing())` still has to pick the void one. A fix that
// erased void earlier — before overload resolution — would make these two
// declarations collide, or send the call to the wrong one.

fn nothing
    ret

fn f x: void
    ret 1

fn f x: i32
    ret 2

fn main
    out "{f(nothing())} {f(5)}"
