//BUG="FEEDBACK.md 1.9 — parse::<f32> accepts inf, nan and exponent forms"
//OUT="2"

// Same root cause as 11. `nan` parses as a float literal, so it cannot be used
// as a variable name. `1e5` is accepted as a literal for the same reason,
// which is a separate question of whether exponent notation should be part of
// the language at all — decide that deliberately rather than inheriting it
// from Rust's float parser.

fn main
    nan = 2
    out "{nan}"
