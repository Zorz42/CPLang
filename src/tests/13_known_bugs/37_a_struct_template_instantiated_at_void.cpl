//BUG="a struct template instantiated at void emits `void F0;`, which gcc rejects"
//OUT="3"

// `void` reaching a field through a template argument rather than through the
// instantiation's values. The instance `Box[void]` should be emitted with only
// its `n` member.

fn nothing
    ret

struct Box[T]
    v: T
    n: i32

fn main
    b = Box[void] v nothing() n 3
    out "{b.n}"
