//BUG="a void tuple element emits `void F9;` in the tuple's struct, which gcc rejects"
//OUT="5"

// Tuples are lowered to structs, so a void element hits the same wall as a void
// field. The element is erased from the emitted struct, but `.1` still names the
// second element as it was written — the index is a source-level position, not
// an index into the members that survive.

fn nothing
    ret

fn main
    a = nothing(), 5
    out "{a.1}"
