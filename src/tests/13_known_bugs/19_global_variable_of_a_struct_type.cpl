//BUG="a global of a struct type is emitted before the struct typedefs"
//OUT="1 99"

// Not in FEEDBACK.md. The generated C declares globals above the typedefs:
//
//     static S0 var0;
//     ...
//     typedef struct S0 { int F0; } S0;
//
// so gcc rejects it with "unknown type name 'S0'". Any global whose type is a
// struct — including a Vec or a Str, which is how you would keep a shared
// buffer between functions — produces C that does not compile. Globals of
// primitive type are fine, which is why the rest of the suite does not hit it.
//
// Fix: emit the struct declarations before the globals in generate_code.

struct Point
    x: i32
    y: i32

origin = Point x 1 y 2

fn main
    a = origin.x
    origin.y = 99
    out "{a} {origin.y}"
