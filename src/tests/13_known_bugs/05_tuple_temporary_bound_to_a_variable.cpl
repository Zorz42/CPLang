//BUG="FEEDBACK.md 1.4 — codegen panics on a struct or tuple temporary"
//OUT="2"

// Same panic as 04. Note that `x = (1, 2)` on its own is fine, because the
// variable's type gets registered; it is only reading a field straight off the
// temporary that has no registered type.

fn main
    x = (1, 2).1
    out "{x}"
