//BUG="a void binding does not build, so the call it wraps cannot be shown to run"
//OUT="1"

// Erasing a void variable must erase the storage and not the work. The binding
// `r = bump()` has no value to keep, but `bump()` still has to be called, so
// the assignment should become a bare expression statement rather than being
// dropped along with the variable.
//
// Today the case fails earlier than that: the generated C declares `void var1;`
// and gcc refuses it. This is the case that says which half of the statement
// survives the fix.

g = 0

fn bump
    g++
    ret

fn main
    r = bump()
    out "{g}"
