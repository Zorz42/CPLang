//BUG="a function template instantiated at void emits a `void` parameter and a `void` local"
//OUT="ok"

// `id[void]` is a void parameter and a void return in one instance, reached
// through an explicit template argument. The instance should come out as a
// C function taking nothing and returning void.

fn id[T] x: T
    ret x

fn nothing
    ret

fn main
    r = id[void](nothing())
    out "ok"
