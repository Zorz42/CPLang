//BUG="destructuring a tuple with a void element emits a `void` member and a `void` local"
//OUT="5"

// The destructuring form of 39_a_void_element_in_a_tuple.cpl. `a` binds the
// void element and is erased; `b` has to still line up with the second element.

fn nothing
    ret

fn main
    a, b = nothing(), 5
    out "{b}"
