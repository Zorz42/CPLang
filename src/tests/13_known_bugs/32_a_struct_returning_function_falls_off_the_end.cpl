//BUG="a function returning a struct may fall off the end, producing a garbage struct"
//ERR any

// Falling off the end is not only an i32 problem, and it gets worse as the
// return type grows: here the caller reads a whole `P` that was never built and
// then reads a field out of it. Nothing about the check should be tied to the
// return type being a primitive.

struct P
    x: i32

fn make n
    if n > 0
        ret P x n

fn main
    p = make(-1)
    out "{p.x}"
