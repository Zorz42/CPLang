//BUG="a void value returned from an untyped parameter emits a `void` parameter"
//OUT="ok"

// The inferred form of 44_a_function_template_instantiated_at_void.cpl: nothing
// in `wrap` is written as void, the type arrives from the call and flows to the
// return. 05_functions/07_bare_return_ends_a_void_function.cpl already covers a
// void return on its own; what is new here is returning a void *value*.

fn nothing
    ret

fn wrap x
    ret x

fn main
    r = wrap(nothing())
    out "ok"
